# serve_audio.py 的 systemd 常驻服务模板。
# 占位符由 install-service.sh 用 sed 填充后写到 /etc/systemd/system/。
# 手工改：填好 @@...@@ 后 `sudo cp` 过去、`systemctl daemon-reload`。

[Unit]
Description=小说章节浏览/音频服务 serve_audio.py (@@TITLE@@)
Documentation=file://@@REPO@@/AGENTS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@USER@@
WorkingDirectory=@@REPO@@
ExecStart=/usr/bin/python3 @@REPO@@/02_工具/01_小说通用工具/serve_audio.py @@NOVEL_DIR@@ --host @@HOST@@ --port @@PORT@@
Restart=on-failure
RestartSec=3

# —— 资源兜底（v3 起会在后台子进程里跑 build_prompt.py / review_manuscript.py /
#    tts_chapter.py，比纯浏览吃得多；这里只是防意外，不是常态占用）——
Nice=10
CPUWeight=20
MemoryMax=1G
TasksMax=256

# —— 加固：除 @@NOVEL_DIR@@（本服务的写入范围）外，其余文件系统只读 ——
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=@@NOVEL_DIR@@
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
